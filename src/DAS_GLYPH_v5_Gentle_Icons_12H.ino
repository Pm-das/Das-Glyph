}

void drawStopwatch() {
  display.clearDisplay();
  statusHeader("STOPWATCH");
  unsigned long elapsed = swElapsed + (swRunning ? millis() - swStart : 0);
  unsigned long centi = elapsed / 10;
  unsigned long mins = centi / 6000;
  unsigned long secs = (centi / 100) % 60;
  unsigned long tenth = (centi % 100) / 10;

  // Progress ring uses more of the screen.
  display.drawCircle(25, 37, 18, SSD1306_WHITE);
  int dotCount = (centi / 10) % 60;
  for (int i = 0; i < dotCount; i++) {
    float a = (i * 6 - 90) * PI / 180.0f;
    display.drawPixel(25 + cosf(a) * 22, 37 + sinf(a) * 22, SSD1306_WHITE);
  }

  display.setTextSize(2);
  display.setCursor(49, 24);
  display.print(two(mins));
  display.print(':');
  display.print(two(secs));
  display.setTextSize(1);
  display.setCursor(51, 43);
  display.print('.');
  display.print(tenth);
  display.print("  ");
  display.print(swRunning ? "RUN" : "PAUSE");
  display.setCursor(3, 57);
  display.print("B1 RESET  B2 START/STOP");
  drawTransitionOverlay();
  display.display();
}

void drawTimer() {
  display.clearDisplay();
  statusHeader("TIMER");
  unsigned long remaining = timerRemaining;
  if (timerRunning) {
    unsigned long elapsed = millis() - timerStarted;
    remaining = elapsed >= timerRemaining ? 0 : timerRemaining - elapsed;
    if (remaining == 0) {
      timerRunning = false;
      timerDone = true;
      timerRemaining = 0;
    }
  }

  unsigned long secsTotal = remaining / 1000;
  unsigned long mins = secsTotal / 60;
  unsigned long secs = secsTotal % 60;
  int cx = 64, cy = 34, r = 23;
  display.drawCircle(cx, cy, r, SSD1306_WHITE);

  if (!timerDone) {
    int progress = timerSetMs > 0 ? (int)(60.0f * remaining / timerSetMs) : 0;
    for (int i = 0; i < progress; i++) {
      float a = (i * 6 - 90) * PI / 180.0f;
      display.drawPixel(cx + cosf(a) * (r + 2), cy + sinf(a) * (r + 2), SSD1306_WHITE);
    }
    display.setTextSize(2);
    display.setCursor(35, 28);
    display.print(two(mins));
    display.print(':');
    display.print(two(secs));
  } else {
    display.setTextSize(2);
    display.setCursor(30, 27);
    display.print("TIME UP");
    if ((millis() / 250) % 2 == 0) display.drawRoundRect(1, 14, 126, 43, 5, SSD1306_WHITE);
  }

  display.setTextSize(1);
  display.setCursor(3, 58);
  display.print("B1 PRESET ");
  display.print(timerSetMs / 60000);
  display.print("M");
  display.setCursor(82, 58);
  display.print(timerRunning ? "B2 PAUSE" : "B2 START");
  drawTransitionOverlay();
  display.display();
}

void drawSystem() {
  display.clearDisplay();
  statusHeader("DEVICE STATUS");
  display.setTextSize(1);
  display.setCursor(3, 17);
  display.print("WIFI  ");
  display.print(WiFi.status() == WL_CONNECTED ? "CONNECTED" : "OFFLINE");
  display.setCursor(3, 28);
  display.print("TIME  ");
  display.print(time(nullptr) > 1700000000 ? "SYNCED" : "WAITING");
  display.setCursor(3, 39);
  display.print("WX    ");
  display.print(weatherOK ? "READY" : "NOT LOADED");
  display.setCursor(3, 50);
  display.print("HEAP  ");
  display.print(ESP.getFreeHeap() / 1024);
  display.print(" KB");
  display.setCursor(3, 60);
  display.print("IP ");
  if (WiFi.status() == WL_CONNECTED) display.print(WiFi.localIP());
  else display.print("NOT CONNECTED");
  drawTransitionOverlay();
  display.display();
}

void drawSettings() {
  display.clearDisplay();
  statusHeader("QUICK SETTINGS");

  const char* names[] = {"TIME FORMAT", "TRANSITIONS", "INVERT OLED"};
  const char* values[] = {
    use24h ? "24 HOUR" : "12 HOUR",
    motionUI ? "ON" : "OFF",
    inverted ? "ON" : "OFF"
  };

  for (int i = 0; i < 3; i++) {
    int y = 17 + i * 14;
    if (i == settingsFocus) {
      display.fillRoundRect(2, y - 2, 124, 13, 3, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
    } else display.setTextColor(SSD1306_WHITE);

    display.setTextSize(1);
    display.setCursor(7, y);
    display.print(names[i]);
    display.setCursor(87, y);
    display.print(values[i]);
    display.setTextColor(SSD1306_WHITE);
  }
  display.setCursor(3, 59);
  display.print("B1 NEXT  B2 CHANGE");
  drawTransitionOverlay();
  display.display();
}

void render() {
  switch (app) {
    case HOME: drawHome(); break;
    case LAUNCHER: drawLauncher(); break;
    case ANALOG_APP: drawAnalog(); break;
    case WEATHER: drawWeather(); break;
    case STOPWATCH: drawStopwatch(); break;
    case TIMER: drawTimer(); break;
    case SYSTEM: drawSystem(); break;
    case SETTINGS: drawSettings(); break;
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_1, INPUT_PULLUP);
  pinMode(BUTTON_2, INPUT_PULLUP);

  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("SSD1306 initialization failed");
    while (true) delay(1000);
  }
  display.setTextColor(SSD1306_WHITE);
  display.clearDisplay();
  display.display();
  bootAnimation();
  setupWiFi();
}

void loop() {
  networkTick();
  pollButtons();

  unsigned long now = millis();
  if (weatherRequest) {
    weatherRequest = false;
    fetchWeather();
  } else if (WiFi.status() == WL_CONNECTED &&
             (lastWeather == 0 || now - lastWeather >= WEATHER_PERIOD)) {
    fetchWeather();
  }

  if (now - lastFrame >= 32) {
    lastFrame = now;
    render();
  }
  delay(1);
}